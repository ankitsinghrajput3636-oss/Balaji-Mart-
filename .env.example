# Balaji Mart Production Configuration

# Razorpay Payment Gateway Key (Optional if using native UPI Intent or Cash on Delivery)
# Configure your Key ID from Razorpay Dashboard (https://dashboard.razorpay.com)
RAZORPAY_KEY_ID=rzp_test_placeholder

# Store Merchant UPI ID for real NPCI UPI Intent (Google Pay, PhonePe, Paytm, BHIM)
STORE_UPI_ID=balajimart@upi

# Balaji Mart Store GPS Coordinates (used for calculating exact 2.0 KM delivery radius)
STORE_LATITUDE=28.6139
STORE_LONGITUDE=77.2090

# Optional Gemini AI key
# GEMINI_API_KEY=MY_GEMINI_API_KEY
